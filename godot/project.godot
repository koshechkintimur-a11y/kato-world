; Engine configuration for Kato World
config_version=5
rendering/renderer/rendering_method="canvas_items"
rendering/2d/default_canvas_item_texture_filter="nearest"
rendering/2d/default_canvas_item_texture_repeat="disabled"
application/config/name="Kato World"
application/config/icon="res://assets/icon.png"
application/run/main_scene="res://scenes/main/main.tscn"
application/run/low_processor_usage_mode="true"
application/run/low_processor_usage_sleep_usec=10000
input/map/1="move_up,ui_up"
input/map/2="move_down,ui_down"
input/map/3="move_left,ui_left"
input/map=4="move_right,ui_right"
input/map/5="interact,ui_accept"
input/map/6="think,ui_cancel"
autoload/singleton/GlobalState="res://scripts/autoload/global_state.gd"
autoload/singleton/EventBus="res://scripts/autoload/event_bus.gd"
autoload/singleton/WorldState="res://scripts/autoload/world_state.gd"
autoload/singleton/BrainClient="res://scripts/autoload/brain_client.gd"
autoload/singleton/MemorySystem="res://scripts/components/memory_system.gd"